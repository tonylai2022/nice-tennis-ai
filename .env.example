# Supabase configuration
# 1) Copy this file to .env.local
# 2) Replace BOTH values with real credentials from: Supabase Dashboard → Project Settings → API
#
# Important: If you leave the placeholder values here, the app will treat Supabase as NOT configured.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Google Gemini (enables real AI coaching feedback)
VITE_GOOGLE_API_KEY=

# Optional: DeepSeek (enables live-coaching AI feedback)
VITE_DEEPSEEK_API_KEY=

# Optional: Web Push public key (must match VAPID_PUBLIC_KEY in Supabase secrets)
VITE_VAPID_PUBLIC_KEY=

# Optional but recommended for Vercel/hosting:
# Force onnxruntime-web to load its WASM binaries from the jsdelivr CDN.
# This avoids host-specific static asset path issues.
# IMPORTANT: Keep the version in this URL aligned with the installed onnxruntime-web version.
VITE_ORT_WASM_BASE_URL=https://cdn.jsdelivr.net/npm/onnxruntime-web@1.23.2/dist/

# Optional: use a service role key for server-side operations (DO NOT put this in client-side .env)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Notes:
# - Add this file to source control. Do NOT commit your real keys; instead fill them in locally in .env or .env.local.
# - After creating .env.local, restart the dev server: npm run dev
